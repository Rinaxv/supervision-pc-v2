# Tauri
src-tauri/target/
src-tauri/gen/schemas
$lignes = "node_modules","dist","src-tauri/target"
if (-not (Test-Path .gitignore)) { New-Item .gitignore -ItemType File | Out-Null }
$actuel = Get-Content .gitignore -ErrorAction SilentlyContinue
Add-Content .gitignore ""
foreach ($l in $lignes) { if ($actuel -notcontains $l) { Add-Content .gitignore $l } }
Get-Content .gitignore